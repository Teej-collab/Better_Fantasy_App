{
  "expo": {
    "name": "Weekend League",
    "slug": "weekend-league",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "weekendleague",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.weekendleague.native",
      "appleTeamId": "5K8V6776KS"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1016",
          "image": "./assets/images/weekend-league-emblem.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Weekend League uses your photos so you can share them in league chat.",
          "cameraPermission": "Weekend League uses your camera so you can snap photos for league chat."
        }
      ],
      "expo-video",
      "./plugins/withSceneLifecycle",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42cbef3d-783f-4260-98fd-295387187554"
      }
    },
    "owner": "tjoverlin",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/42cbef3d-783f-4260-98fd-295387187554",
      "requestHeaders": {
        "expo-channel-name": "main"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
