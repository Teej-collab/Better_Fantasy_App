# Base44 dev defaults — placeholders so the app boots without external
# credentials. Real secrets (when provided via the dashboard) are
# delivered to /run/base44/app.env and override these (listed LAST in
# the compose env_file order).

# Session cookie signing — generated placeholder for local dev only.
SESSION_SECRET=base44-dev-session-secret-do-not-use-in-production

# CORS — the frontend's server-side proxy calls the backend within the
# docker network (not subject to CORS); client-side authed calls go
# through the same-origin /api/backend proxy. This default covers local.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ESPN sync — off by default, no credentials needed to boot.
ESPN_DRY_RUN=true
ACTIVE_SEASON=2026
ENABLE_ESPN_SYNC_SCHEDULER=false
ENABLE_LIVE_SYNC_SCHEDULER=false
ENABLE_GAMECAST_SCHEDULER=false
ENABLE_SLEEPER_PLAYER_SYNC_SCHEDULER=false
ENABLE_DRAFT_CLOCK_SCHEDULER=false
ENABLE_WEEKLY_COMPUTE_SCHEDULER=false

# Frontend URL for OAuth redirects (not exercised without Discord creds).
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
