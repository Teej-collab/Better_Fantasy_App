# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it, never zip it into a shared file.

# --- Database (Postgres — same Supabase project Fantasy_Helper uses) ---
# Phase 1: backend is read-only against this DB. Use a read-only role if
# your Supabase project has one set up; otherwise be careful not to add
# write queries here until that's explicitly revisited.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- LLM (Narrative Engine, ported later in the roadmap) ---
ANTHROPIC_API_KEY=
