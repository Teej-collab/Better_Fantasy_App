# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it, never zip it into a shared file.

# --- Database (Postgres — same Supabase project Fantasy_Helper uses) ---
# Phase 3 note: ESPN sync writes to this DB (teams/matchups/rosters).
# Nothing writes automatically — POST /admin/sync is the manual trigger,
# and the scheduled job is off unless ENABLE_ESPN_SYNC_SCHEDULER=true (see
# below). Do not point this at production Supabase and enable either one
# without confirming that's actually intended — see DEVELOPMENT.md.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- LLM (Narrative Engine, ported later in the roadmap) ---
ANTHROPIC_API_KEY=

# --- ESPN (private league auth — only required if you call /admin/sync or
# enable the scheduler; the rest of the backend runs fine without these) ---
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=
ACTIVE_SEASON=2026
# Defaults to ACTIVE_SEASON if unset — set this to your league's actual
# first season to sync full history.
LEAGUE_START_SEASON=

# --- ESPN lineup mutation layer (app/providers/espn/lineup_client.py) ---
# Defaults to true (safe) if unset or anything other than exactly
# "false". While true, set_lineup()/swap_players() log the exact
# mutation they would send and never call ESPN. There is currently no
# code path that sends a real write to ESPN regardless of this flag —
# see backend/docs/ESPN_LINEUP_WRITE.md for why, and what's still needed
# before that changes.
ESPN_DRY_RUN=true

# --- Scheduled full sync (off by default — see app/scheduler.py) ---
# The complete historical scan. Meant for a slow cadence.
ENABLE_ESPN_SYNC_SCHEDULER=false
SYNC_INTERVAL_HOURS=24

# --- Scheduled live sync (off by default — see app/scheduler.py) ---
# Re-syncs just the current week's matchups/rosters + boom/bust, fast
# enough to poll during live games. Gated to whether a real NFL game is
# actually live right now (app/providers/nfl_scoreboard.py) — the
# interval below is how often it TICKS, not how often it actually calls
# ESPN's fantasy API; outside a live game it's a no-op. Seconds, not
# minutes (was LIVE_SYNC_INTERVAL_MINUTES=5) — tightened so a live
# touchdown shows up as fantasy points much closer to real time.
ENABLE_LIVE_SYNC_SCHEDULER=false
LIVE_SYNC_INTERVAL_SECONDS=60

# --- Sportradar NFL (Gamecast — live game score/play-by-play, see
# app/gamecast/) — leave unset to fall back to ESPN's own public
# scoreboard/summary API (app/gamecast/providers/espn.py, no key
# needed), or set GAMECAST_PROVIDER=mock to force the built-in
# simulation (app/gamecast/providers/mock.py) instead of either real
# source. Never place this key in frontend code or a NEXT_PUBLIC_ var —
# the frontend only ever talks to Gamecast through this backend. ---
SPORTRADAR_API_KEY=

# --- Scheduled Gamecast poll (off by default — see app/scheduler.py)
# ---
# Polls the configured live-game provider (Sportradar if the key above
# is set, otherwise ESPN's public scoreboard/summary API, or the mock
# simulation if GAMECAST_PROVIDER=mock) and pushes updates over
# WebSocket to anyone watching a game's Gamecast right now. Gated the
# same way as live sync above (a real NFL game has to actually be live)
# plus its own inner check — a game nobody's currently connected to
# isn't polled, so this costs nothing when Gamecast has zero viewers.
ENABLE_GAMECAST_SCHEDULER=false
GAMECAST_POLL_INTERVAL_SECONDS=4

# --- CORS (Phase 4: frontend calling this API from a browser) ---
# Comma-separated list of origins allowed to call this API. Defaults to
# the local Next.js dev server if unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Discord OAuth login (Phase 5) — see DEVELOPMENT.md for how to
# register a Discord application and get these values. Only required
# once someone hits /auth/discord/login; the rest of the backend runs
# fine without them. ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered on the Discord application.
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
# Random string used to sign session cookies — generate your own with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`,
# don't reuse this placeholder.
SESSION_SECRET=
# Where to send the browser after a successful/failed login.
FRONTEND_URL=http://localhost:3000
# true in real production (HTTPS) — false here since local dev runs
# over plain http on a LAN IP (phones), where a Secure cookie won't set.
SESSION_COOKIE_SECURE=false
# Optional — your own Discord user ID, for the is_commissioner flag on
# the session. Matches Fantasy_Helper's bot/config.py COMMISSIONER_DISCORD_ID.
COMMISSIONER_DISCORD_ID=

# --- Web Push (app/routers/push.py, app/notifications/) — the whole
# feature runs fine with these unset (routes that need them fail with a
# clear 503/RuntimeError rather than silently no-op-ing — see
# app/config.py's require_vapid_configured). Generate a real keypair
# with:
#   python3 -c "
#   from py_vapid import Vapid02
#   import base64
#   from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
#   v = Vapid02(); v.generate_keys()
#   b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()
#   print('VAPID_PUBLIC_KEY=' + b64(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)))
#   print('VAPID_PRIVATE_KEY=' + b64(v.private_key.private_numbers().private_value.to_bytes(32, 'big')))
#   "
# Never reuse a keypair between environments — generate a fresh one for
# production, don't copy your local dev keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URL/email the push provider can reach if something's wrong
# with your usage — required by the Web Push protocol, not optional.
VAPID_SUBJECT=mailto:you@example.com
