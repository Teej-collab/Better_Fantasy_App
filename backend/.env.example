# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it, never zip it into a shared file.

# --- Database (Postgres — same Supabase project Fantasy_Helper uses) ---
# Phase 3 note: ESPN sync writes to this DB (teams/matchups/rosters).
# Nothing writes automatically — POST /admin/sync is the manual trigger,
# and the scheduled job is off unless ENABLE_ESPN_SYNC_SCHEDULER=true (see
# below). Do not point this at production Supabase and enable either one
# without confirming that's actually intended — see DEVELOPMENT.md.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- LLM (Narrative Engine, ported later in the roadmap) ---
ANTHROPIC_API_KEY=

# --- ESPN (private league auth — only required if you call /admin/sync or
# enable the scheduler; the rest of the backend runs fine without these) ---
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=
ACTIVE_SEASON=2026
# Defaults to ACTIVE_SEASON if unset — set this to your league's actual
# first season to sync full history.
LEAGUE_START_SEASON=

# --- Admin endpoints (stopgap until real auth in Phase 5) ---
# POST /admin/sync requires this exact value in an X-Admin-Token header.
# Leave unset to disable the endpoint entirely (it 501s).
ADMIN_SYNC_TOKEN=

# --- Scheduled sync job (off by default — see app/scheduler.py) ---
ENABLE_ESPN_SYNC_SCHEDULER=false
SYNC_INTERVAL_HOURS=24

# --- CORS (Phase 4: frontend calling this API from a browser) ---
# Comma-separated list of origins allowed to call this API. Defaults to
# the local Next.js dev server if unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Discord OAuth login (Phase 5) — see DEVELOPMENT.md for how to
# register a Discord application and get these values. Only required
# once someone hits /auth/discord/login; the rest of the backend runs
# fine without them. ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered on the Discord application.
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
# Random string used to sign session cookies — generate your own with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`,
# don't reuse this placeholder.
SESSION_SECRET=
# Where to send the browser after a successful/failed login.
FRONTEND_URL=http://localhost:3000
# true in real production (HTTPS) — false here since local dev runs
# over plain http on a LAN IP (phones), where a Secure cookie won't set.
SESSION_COOKIE_SECURE=false
# Optional — your own Discord user ID, for the is_commissioner flag on
# the session. Matches Fantasy_Helper's bot/config.py COMMISSIONER_DISCORD_ID.
COMMISSIONER_DISCORD_ID=
